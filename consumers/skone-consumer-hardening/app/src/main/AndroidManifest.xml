<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConsumerHardening">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ConsumerHardening">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".xml.XmlListFilterActivity"
            android:exported="false"
            android:label="XML List Filter" />
        <activity
            android:name=".xml.XmlFormActivity"
            android:exported="false"
            android:label="XML Form" />
        <activity
            android:name=".xml.XmlShellActivity"
            android:exported="false"
            android:label="XML Shell" />
    </application>
</manifest>
